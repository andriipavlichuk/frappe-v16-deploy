# ===========================================================================
# slife v16 deployment configuration  (EXAMPLE — copy to config.env and edit)
# All scripts source this file.
# ===========================================================================

# ---- Project / site ----
PROJECT_NAME=slife16
SITE_NAME=slife.localhost
DOMAIN=localhost
# On the server set: SITE_NAME=slife.guru  DOMAIN=slife.guru

# ---- Paths ----
# Local: use a CLEAN frappe_docker (not the server-customized frappe_docker_betop):
FRAPPE_DOCKER_PATH=/home/notjusta/Work/slife-deploy/frappe_docker
GITOPS_PATH=/home/notjusta/Work/slife-v16-deploy/gitops
# On the server (use a vanilla v16-capable frappe_docker, NOT frappe_docker_betop):
# FRAPPE_DOCKER_PATH=/root/frappe_docker
# GITOPS_PATH=/root/gitops-slife16

# ---- Image build ----
# BUILD_MODE=build  -> build a custom image from FRAPPE_DOCKER_PATH + apps.json (bash build.sh), then deploy uses it
# BUILD_MODE=official -> use the official frappe/erpnext image and install extra apps at runtime
BUILD_MODE=build
FRAPPE_REPO=https://github.com/frappe/frappe
FRAPPE_BRANCH=version-16
# Local build tag (produced by build.sh). On the server push to your registry instead.
IMAGE_TAG=slife16/erpnext:v16
# PYTHON_VERSION must be >=3.14 (payments requires it); matches the official frappe/erpnext image.
PYTHON_VERSION=3.14.2
NODE_VERSION=24.13.0
# For a registry image instead:
# IMAGE_TAG=slifedev/erpnext-16:1.0.0

# Extra frappe-made apps (besides erpnext) installed at runtime in official mode.
# Format: "name|url|branch" separated by spaces.
EXTRA_APPS="payments|https://github.com/frappe/payments|version-16 lms|https://github.com/frappe/lms|develop hrms|https://github.com/frappe/hrms|version-16 raven|https://github.com/The-Commit-Company/raven|develop"

# ---- Apps ----
APPS_JSON=/home/notjusta/Work/slife-v16-deploy/apps.json

# ---- Secrets (CHANGE THESE) ----
DB_PASSWORD=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME

# ---- Networking ----
# http   = local test, frontend on a port, no Traefik
# traefik = server, TLS via Traefik + Let's Encrypt (needs DNS for DOMAIN + gitops/traefik.env)
MODE=http
HTTP_PORT=8080
