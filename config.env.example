# ===========================================================================
# Frappe ERPNext v16 deployment configuration
# Generated by new-project.sh — DO NOT EDIT MANUALLY
# All scripts source this file.
# ===========================================================================

# ---- Project / site ----
PROJECT_NAME=myproject
SITE_NAME=myproject.localhost
DOMAIN=localhost

# ---- Paths ----
GITOPS_PATH=./gitops

# ---- Image build ----
FRAPPE_REPO=https://github.com/frappe/frappe
FRAPPE_BRANCH=version-16
IMAGE_TAG=myproject/erpnext:v16
PYTHON_VERSION=3.14.2
NODE_VERSION=24.13.0

# ---- Apps (baked into custom Docker image) ----
APPS_JSON=./apps.json
APPS_CUSTOM_JSON=./apps.custom.json

# ---- Secrets (CHANGE THESE IN PRODUCTION) ----
DB_PASSWORD=123
ADMIN_PASSWORD=changeme

# ---- Networking ----
# http   = local test, frontend on a port, no Traefik
# traefik = server, TLS via Traefik + Let's Encrypt (requires gitops/traefik.env)
MODE=http
HTTP_PORT=8080
